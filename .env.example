# .env.example — variables de entorno del proyecto (SIN valores reales).
# Cópialo a .env (gitignored) y rellena. Documenta aquí cada variable nueva.
# La URL y la contraseña del escritorio NO van aquí: llegan en cada POST /tasks.

# --- Servidor ---
# NODE_ENV=production
# PORT=3000
# LOG_LEVEL=info

# --- Auth (obligatoria, fail-fast) ---
# Token Bearer que exigen /tasks y /tasks/:id (GET /health es abierto).
AGENT_API_TOKEN=

# --- LLM multimodal vía OpenRouter (obligatorias, fail-fast) ---
OPENROUTER_API_KEY=
# Id del modelo en OpenRouter. Debe aceptar imágenes (input_modalities incluye "image").
# Por defecto recomendado: anthropic/claude-sonnet-5.5. Sin variantes :batch ni -exp.
LLM_MODEL=
# Opcional: alternativas separadas por comas (parámetro `models` de OpenRouter), p. ej.
# openai/gpt-6.1-sol,google/gemini-3.8-flash
# LLM_FALLBACK_MODELS=

# --- Persistencia (ADR-0011) ---
# Fichero SQLite; en Docker, dentro del volumen montado en /data.
# DATABASE_PATH=/data/agent-screen.db
